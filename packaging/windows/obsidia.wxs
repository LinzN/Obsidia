<!--
  Windows installer (WiX 5).
  wix build packaging/windows/obsidia.wxs -arch x64 -ext WixToolset.UI.wixext
      -d Version=x.y.z -d Root=<repo root> -o out/obsidia.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Obsidia"
           Manufacturer="MirraNET"
           Version="$(Version)"
           UpgradeCode="5B1E7C2D-3F4A-4C8B-9E21-7A6D0F3B8C54"
           Scope="perMachine"
           Compressed="yes">

    <!-- AllowSameVersionUpgrades: a rebuild with the same version replaces the
         existing installation instead of being installed side by side -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Obsidia is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(Root)\assets\obsidia.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://mirranet.de" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/LinzN/obsidia/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/LinzN/obsidia/issues" />

    <WixVariable Id="WixUILicenseRtf" Value="$(Root)\packaging\windows\license.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Obsidia">
        <Directory Id="TOOLSFOLDER" Name="tools" />
        <Directory Id="ETCFOLDER" Name="etc" />
      </Directory>
    </StandardDirectory>

    <!-- Firmware shared by all users of the computer: C:\Obsidia\Firmware -->
    <StandardDirectory Id="TARGETDIR">
      <Directory Id="DATAFOLDER" Name="Obsidia">
        <Directory Id="FIRMWAREFOLDER" Name="Firmware" />
      </Directory>
    </StandardDirectory>
    <SetDirectory Id="DATAFOLDER" Value="[WindowsVolume]Obsidia" />

    <Feature Id="Main" Title="Obsidia" Level="1">
      <Component Directory="INSTALLFOLDER">
        <File Source="$(Root)\dist\obsidia.exe" KeyPath="yes" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Source="$(Root)\LICENSE" Name="LICENSE.txt" />
      </Component>
      <Files Directory="TOOLSFOLDER" Include="$(Root)\dist\tools\**" />
      <Files Directory="ETCFOLDER" Include="$(Root)\dist\etc\**" />

      <!-- Everyone may add and remove firmware. The folder and downloaded files
           stay when Obsidia is uninstalled. -->
      <Component Id="SharedFirmwareFolder" Directory="DATAFOLDER" Permanent="yes">
        <CreateFolder>
          <PermissionEx Sddl="D:(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;BU)(A;OICI;FA;;;CO)" />
        </CreateFolder>
        <CreateFolder Directory="FIRMWAREFOLDER">
          <PermissionEx Sddl="D:(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;BU)(A;OICI;FA;;;CO)" />
        </CreateFolder>
        <RegistryValue Root="HKLM" Key="Software\MirraNET\Obsidia" Name="FirmwareFolder"
                       Type="string" Value="[FIRMWAREFOLDER]" KeyPath="yes" />
      </Component>
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
        <Shortcut Name="Obsidia" Description="iPhone &amp; iPad firmware tool"
                  Target="[INSTALLFOLDER]obsidia.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKLM" Key="Software\MirraNET\Obsidia" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="DesktopShortcut" Directory="DesktopFolder">
        <Shortcut Name="Obsidia" Description="iPhone &amp; iPad firmware tool"
                  Target="[INSTALLFOLDER]obsidia.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKLM" Key="Software\MirraNET\Obsidia" Name="DesktopShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>

<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "binaries": the program and the bundled
     command line tools, signed before they are packed into the MSI. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="obsidia.exe">
      <authenticode-sign />
    </pe-file>
    <directory path="tools">
      <pe-file-set>
        <include path="*.exe" max-matches="unbounded" />
        <include path="*.dll" max-matches="unbounded" />
        <for-each>
          <authenticode-sign />
        </for-each>
      </pe-file-set>
    </directory>
  </zip-file>
</artifact-configuration>
